{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
  assign drawer_cfg = drawer_section.settings
  assign protection_product = drawer_cfg.protection_product
  assign protection_variant = blank
  if drawer_cfg.show_shipping_protection and protection_product != blank
    assign protection_variant = protection_product.selected_or_first_available_variant
  endif
  assign protection_line_key = ''
  assign protection_quantity = 0

  for item in cart.items
    if protection_product != blank and item.product.id == protection_product.id
      assign protection_line_key = item.key
      assign protection_quantity = item.quantity
      break
    endif
  endfor

  assign regular_item_count = cart.item_count | minus: protection_quantity
  assign drawer_has_payment_block = false
  for customizable_block in drawer_section.blocks
    if customizable_block.type == 'payments'
      assign drawer_has_payment_block = true
    endif
  endfor
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}

  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>


  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ drawer_cfg.empty_cart_heading | default: 'content.your_cart_is_empty' | escape }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products',
          force_empty: true,
          context: 'drawer'
        %}
      </div>
      {% for block in drawer_section.blocks %}
        {% if block.settings.placement == 'empty_cart' %}
          {% render 'avonent-cart-drawer-block', block: block %}
        {% endif %}
      {% endfor %}
    </div>
  {% endcapture %}


  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >

    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer avonent-cart-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
      style="--av-drawer-width:{{ drawer_cfg.width | default: 440 }}px;--av-drawer-background:{{ drawer_cfg.background | default: '#FFFFFF' }};--av-drawer-text:{{ drawer_cfg.text_color | default: '#171513' }};--av-drawer-accent:{{ drawer_cfg.accent | default: '#A84F1B' }}"
    >

      <cart-drawer-component
        auto-open
        data-protection-variant-id="{{ protection_variant.id }}"
        data-protection-handle="{{ protection_product.handle | escape }}"
      >

        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>


        <div
          class="
            cart-drawer__inner
            {% if cart.empty? %}
              cart-drawer--empty
            {% endif %}
          "
          data-hydration-key="cart-drawer-inner"
        >

          {%- if cart.empty? -%}

            <div class="theme-drawer__header avonent-cart-drawer__header">

              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>

            </div>

          {%- else -%}

            {% capture cart_badge_html %}
              <span
                class="
                  theme-drawer__badge
                  {% if regular_item_count == 0 %}
                    visually-hidden
                  {% endif %}
                "
                aria-hidden="true"
                {% if regular_item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- regular_item_count -}}
              </span>

              {% if regular_item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}:
                  {{ regular_item_count }}
                </span>
              {% endif %}
            {% endcapture %}

            {% assign cart_drawer_title = drawer_cfg.cart_title | default: 'content.cart_title' %}

            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}

          {%- endif -%}


          {% comment %}No simulated cart reservations or resetting countdowns.{% endcomment %}

          {% capture cart_items_children %}

            {%- if cart.empty? -%}

              {{ empty_cart_drawer_content }}

            {%- else -%}

              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >
                {% for block in drawer_section.blocks %}
                  {% if block.settings.placement == 'before_items' %}
                    {% render 'avonent-cart-drawer-block', block: block %}
                  {% endif %}
                {% endfor %}

                <scroll-hint class="cart-drawer__items">

                  {% render 'cart-products',
                    context: 'drawer'
                  %}

                  {% comment %}
                    Soursop-only cart reassurance; no changes to the cinnamon cart
                    or to the subscription / discount logic.
                  {% endcomment %}
                  {% assign av_soursop_in_cart = false %}
                  {% for av_cart_item in cart.items %}
                    {% if av_cart_item.product.handle == 'soursop-softgels' %}
                      {% assign av_soursop_in_cart = true %}
                      {% break %}
                    {% endif %}
                  {% endfor %}
                  {% if av_soursop_in_cart %}
                    <section class="av-cart-soursop-assurance" aria-label="Why choose Avonent Soursop">
                      <div class="av-cart-soursop-benefits">
                        <div class="av-cart-soursop-benefit">
                          <span class="av-cart-soursop-benefit__icon av-cart-soursop-benefit__icon--dose" aria-hidden="true">1K</span>
                          <strong>1,000 mg<br>per serving</strong>
                        </div>
                        <div class="av-cart-soursop-benefit">
                          <span class="av-cart-soursop-benefit__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none"><path d="m12 2 8 4v6c0 5-3.4 8-8 10-4.6-2-8-5-8-10V6l8-4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8 12 2.5 2.5L16 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          </span>
                          <strong>Third-party<br>lab verified</strong>
                        </div>
                        <div class="av-cart-soursop-benefit">
                          <span class="av-cart-soursop-benefit__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M20 3c-11 0-17 5-17 13a5 5 0 0 0 5 5c8 0 13-6 12-18Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M5 19c4-6 8-9 13-12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                          </span>
                          <strong>Made with<br>real soursop leaf</strong>
                        </div>
                        <div class="av-cart-soursop-benefit">
                          <span class="av-cart-soursop-benefit__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M8.7 4.6a5.2 5.2 0 0 1 7.4 0l3.3 3.3a5.2 5.2 0 0 1-7.4 7.4L8.7 12a5.2 5.2 0 0 1 0-7.4Z" stroke="currentColor" stroke-width="1.8"/><path d="m10.4 13.7-5 5a3.6 3.6 0 0 1-5.1-5.1l5-5" transform="translate(2 0)" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                          </span>
                          <strong>No bitter tea.<br>Just 2 softgels.</strong>
                        </div>
                      </div>
                      <div class="av-cart-soursop-guarantee">
                        <img src="https://cdn.shopify.com/s/files/1/0759/3525/2646/files/avonent-90-day-money-back-guarantee.png?v=1793736254" width="52" height="52" loading="lazy" alt="90-day money-back guarantee">
                        <div>
                          <strong>90-Day Money-Back Guarantee</strong>
                          <p><b>Less than 1%</b> of customers use our 90-Day Money-Back Guarantee.</p>
                        </div>
                      </div>
                    </section>
                  {% endif %}

                </scroll-hint>

                {% for block in drawer_section.blocks %}
                  {% if block.settings.placement == 'after_items' %}
                    {% render 'avonent-cart-drawer-block', block: block %}
                  {% endif %}
                {% endfor %}

                <div class="cart-drawer__summary">
                  {% for block in drawer_section.blocks %}
                    {% if block.settings.placement == 'before_checkout' %}
                      {% render 'avonent-cart-drawer-block', block: block %}
                    {% endif %}
                  {% endfor %}

                  {%- if protection_variant != blank and regular_item_count > 0 -%}
                    <div
                      class="avonent-shipping-protection"
                      data-avonent-protection
                      data-line-key="{{ protection_line_key }}"
                      data-enabled="{% if protection_line_key != blank %}true{% else %}false{% endif %}"
                    >
                      <span class="avonent-shipping-protection__icon" aria-hidden="true">
                        <svg viewBox="0 0 48 48" fill="none">
                          <path d="M10 17.5 24 10l14 7.5v10.2c0 7.2-5.8 12.6-14 15.3-8.2-2.7-14-8.1-14-15.3V17.5Z" fill="currentColor" opacity=".14"/>
                          <path d="M10 17.5 24 10l14 7.5v10.2c0 7.2-5.8 12.6-14 15.3-8.2-2.7-14-8.1-14-15.3V17.5Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
                          <path d="m18.5 26.2 3.7 3.7 7.8-8.1" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>

                      <div class="avonent-shipping-protection__copy">
                        <div class="avonent-shipping-protection__heading">
                          <strong>{{ drawer_cfg.protection_title | escape }}</strong>
                          <span>{{ protection_variant.price | money }}</span>
                        </div>
                        <p>{{ drawer_cfg.protection_description | escape }}</p>
                      </div>

                      <button
                        type="button"
                        class="avonent-shipping-protection__toggle"
                        role="switch"
                        aria-label="{{ drawer_cfg.protection_title | escape }}"
                        aria-checked="{% if protection_line_key != blank %}true{% else %}false{% endif %}"
                        data-avonent-protection-toggle
                      >
                        <span></span>
                      </button>
                    </div>
                  {%- endif -%}

                  {% render 'cart-summary',
                    section_id: 'cart-drawer-section',
                    drawer_settings: drawer_cfg,
                    suppress_payment_icons: drawer_has_payment_block
                  %}
                  {% for block in drawer_section.blocks %}
                    {% if block.settings.placement == 'after_checkout' %}
                      {% render 'avonent-cart-drawer-block', block: block %}
                    {% endif %}
                  {% endfor %}

                </div>

              </scroll-hint>

            {%- endif -%}

          {% endcapture %}


          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}

        </div>

      </cart-drawer-component>

    </dialog>

  </theme-drawer>


  {% if render_wrapper %}
    </div>
  {% endif %}

{%- endif -%}


<style>
  #cart-drawer .theme-drawer__dialog,
  #cart-drawer .avonent-cart-drawer {
    width: min(100vw, var(--av-drawer-width, 440px));
    max-width: 100vw;
    background: var(--av-drawer-background, #fff);
    color: var(--av-drawer-text, #171513);
  }
  #cart-drawer .avonent-drawer-block {
    padding: 12px 20px;
    color: var(--av-drawer-text, #171513);
  }
  #cart-drawer .avonent-drawer-block__progress {
    height: 8px;overflow:hidden;border-radius:99px;background:#eee6df;margin-top:10px
  }
  #cart-drawer .avonent-drawer-block__progress > span {
    display:block;height:100%;background:var(--av-progress,var(--av-drawer-accent,#A84F1B));
    border-radius:inherit;max-width:100%;transition:width .2s
  }
  #cart-drawer .avonent-drawer-block__announcement {background:var(--av-block-bg,#fff5ec);padding:12px;border-radius:10px}
  #cart-drawer .avonent-drawer-block__image {display:block;width:100%;height:auto}
  #cart-drawer .cart-drawer__summary .avonent-cart-checkout {background:var(--av-drawer-accent,#A84F1B);border-color:var(--av-drawer-accent,#A84F1B);color:#fff}
  #cart-drawer .avonent-drawer-block__payments {text-align:center}
  #cart-drawer .avonent-drawer-block__payments-title {font-size:12px;margin:0 0 10px;opacity:.78}
  #cart-drawer .avonent-drawer-block__payments > img {max-width:100%;height:auto}
  #cart-drawer .avonent-drawer-block__payment-icons {display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:5px}
  #cart-drawer .avonent-drawer-block__payment-icons span {display:grid;place-items:center;background:#fff;border:1px solid #e2e2e2;border-radius:5px;width:45px;height:30px;overflow:hidden}
  #cart-drawer .avonent-drawer-block__payment-icons svg {width:39px;max-height:24px}
  #cart-drawer .avonent-drawer-block__trust {display:flex;justify-content:space-around;gap:10px;flex-wrap:wrap;font-size:12px;text-align:center}
  #cart-drawer .avonent-drawer-block__upsell {display:flex;align-items:center;gap:12px;border:1px solid #eee6df;border-radius:12px;padding:12px}
  #cart-drawer .avonent-drawer-block__upsell img {width:70px;height:70px;object-fit:cover;border-radius:8px}
  #cart-drawer .avonent-drawer-block__upsell a {color:var(--av-drawer-accent,#A84F1B)}
  #cart-drawer .avonent-drawer-block__richtext p {margin:.3em 0}
</style>
{% stylesheet %}

  /*
   * HORIZON CART DRAWER BASE
   */

  cart-drawer-component {
    --cart-drawer-padding:
      var(--theme-drawer-padding);

    --font-paragraph--line-height: 1;

    display: contents;
  }


  .cart-drawer__inner {
    display: flex;
    flex-direction: column;

    height: 100%;

    overflow: hidden;
  }


  .cart-drawer__inner
    > .cart-items-component {
    flex: 1;

    min-height: 0;
    height: auto;
  }


  .cart-drawer__content {
    display: flex;
    flex-direction: column;

    padding: 0;

    background-color:
      var(--color-background);

    flex-grow: 1;

    overflow-y: auto;
  }


  .cart-drawer__items {
    display: flex;
    flex-direction: column;

    padding-inline:
      var(--cart-drawer-padding);

    overflow-y: auto;
  }


  .cart-drawer__items
    .cart-items__table-row {
    padding-bottom:
      var(--gap-xl);

    border-bottom:
      var(--style-border-width)
      solid
      rgb(
        var(--color-foreground-rgb)
        /
        var(--opacity-10-25)
      );

    margin-bottom:
      var(--gap-xl);
  }


  .cart-drawer__items
    .cart-items__table-row:has(
      + .cart-items__nested-line
    ) {
    border-bottom: none;

    margin-bottom: 0;
  }


  .cart-drawer__items
    .cart-items__table-row:last-child {
    border-bottom: none;

    padding-block-end: 0;

    margin-block-end: 0;
  }


  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }


  .cart-drawer__summary {
    --cart-drawer-summary-padding:
      var(--padding-lg);

    position: sticky;

    bottom: 0;
    z-index: 1;

    display: flex;
    flex-direction: column;
    align-items: center;

    gap:
      var(--gap-xl);

    padding:
      var(--cart-drawer-summary-padding);

    margin-top: auto;

    background-color:
      var(--color-background);

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black var(--cart-drawer-summary-padding)
      );

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding:
        var(--padding-2xl);
    }
  }


  .theme-drawer__dialog[
    cart-summary-sticky='false'
  ]
  .cart-drawer__summary {
    position: static;

    mask-image: none;
  }


  .theme-drawer__dialog[
    cart-summary-sticky='false'
  ]
  .cart-drawer__items {
    overflow: unset;
  }


  .cart-actions summary {
    padding-inline: 0;

    padding-block:
      var(--padding-sm);

    line-height: 1.2;

    min-height:
      var(--minimum-touch-target);
  }


  .cart-drawer__summary
    .cart__summary-totals:not(
      :has(
        .cart__subtotal-container:empty
      )
    ) {
    border-block-start:
      var(--style-border-width)
      solid
      rgb(
        var(--color-foreground-rgb)
        /
        var(--opacity-10-25)
      );

    padding-block-start:
      var(--padding-2xl);
  }


  .cart-drawer__summary
    .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start:
        var(--margin-3xs);
    }
  }


  .cart-drawer--empty
    .cart-drawer__content {
    text-align: center;

    align-items: center;
    justify-content: center;

    min-height: auto;
  }


  .cart-drawer--empty
    .cart-drawer__items {
    padding-inline: 0;
  }


  cart-drawer-component:not(
    :has(.cart-form)
  )
  .cart-drawer__content {
    text-align: center;

    align-items: center;
    justify-content: center;
  }


  cart-drawer-component:not(
    :has(.cart-form)
  )
  .cart-drawer__items {
    padding-inline: 0;
  }


  /*
   * AVONENT DRAWER WIDTH
   */

  #cart-drawer
    .theme-drawer__dialog {
    --theme-drawer-width:
      min(
        500px,
        100vw
      );

    width:
      var(--theme-drawer-width);

    max-width:
      var(--theme-drawer-width);

    background:
      #ffffff;

    border-left:
      1px solid
      #e7ebed;
  }


  /*
   * HEADER
   */

  #cart-drawer
    .theme-drawer__header {
    min-height: 74px;

    padding:
      18px
      22px;

    border-bottom:
      1px solid
      #e7ebed;

    background:
      #ffffff;
  }


  #cart-drawer
    .theme-drawer__title {
    color:
      #111111;

    font-family:
      var(--font-heading--family);

    font-size: 25px;

    font-weight: 650;

    line-height: 1;

    letter-spacing:
      -0.025em;
  }


  #cart-drawer
    .theme-drawer__badge {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-width: 25px;
    height: 25px;

    margin-left: 8px;

    padding-inline: 6px;

    border-radius: 999px;

    background:
      #eafaff;

    color:
      #078daa;

    font-family:
      var(--font-body--family);

    font-size: 11px;

    font-weight: 700;
  }


  /*
   * CLOSE BUTTON
   */

  #cart-drawer
    .theme-drawer__close-button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 40px;
    height: 40px;

    border:
      1px solid
      #dfe5e7;

    border-radius: 50%;

    background:
      #ffffff;

    color:
      #111111;

    box-shadow: none;

    transition:
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }


  #cart-drawer
    .theme-drawer__close-button:hover {
    border-color:
      #bdeef7;

    background:
      #eafaff;

    color:
      #02c6ea;

    transform:
      rotate(3deg);
  }


  /*
   * CART ITEM AREA
   */

  #cart-drawer
    .cart-drawer__items {
    padding-inline:
      22px;

    padding-top:
      20px;
  }


  #cart-drawer
    .cart-drawer__items
    .cart-items__table-row {
    padding-bottom:
      22px;

    margin-bottom:
      22px;

    border-color:
      #edf0f1;
  }


  /*
   * SUMMARY
   */

  #cart-drawer
    .cart-drawer__summary {
    --cart-drawer-summary-padding:
      22px;

    gap:
      16px;

    padding:
      22px;

    border-top:
      1px solid
      #e7ebed;

    background:
      #ffffff;

    mask-image: none;

    box-shadow:
      0
      -14px
      36px
      rgba(0, 0, 0, 0.035);
  }


  /*
   * EMPTY CART
   */

  #cart-drawer
    .cart-drawer--empty
    .cart-drawer__content {
    padding:
      40px
      22px;
  }


  #cart-drawer
    .cart-drawer--empty
    .theme-drawer__title {
    text-align: center;
  }


  /*
   * SCROLLBARS
   */

  #cart-drawer
    .cart-drawer__content,
  #cart-drawer
    .cart-drawer__items {
    scrollbar-width: thin;

    scrollbar-color:
      #dfe5e7
      transparent;
  }


  #cart-drawer
    .cart-drawer__content::-webkit-scrollbar,
  #cart-drawer
    .cart-drawer__items::-webkit-scrollbar {
    width: 5px;
  }


  #cart-drawer
    .cart-drawer__content::-webkit-scrollbar-thumb,
  #cart-drawer
    .cart-drawer__items::-webkit-scrollbar-thumb {
    border-radius: 999px;

    background:
      #dfe5e7;
  }


  /*
   * MOBILE
   */

  @media screen and (max-width: 749px) {

    #cart-drawer
      .theme-drawer__dialog {
      --theme-drawer-width:
        100%;

      width: 100%;
      max-width: 100%;
    }


    #cart-drawer
      .theme-drawer__header {
      min-height: 68px;

      padding:
        14px
        16px;
    }


    #cart-drawer
      .theme-drawer__title {
      font-size: 23px;
    }


    #cart-drawer
      .theme-drawer__close-button {
      width: 38px;
      height: 38px;
    }


    #cart-drawer
      .cart-drawer__items {
      padding-inline:
        16px;

      padding-top:
        17px;
    }


    #cart-drawer
      .cart-drawer__items
      .cart-items__table-row {
      padding-bottom:
        18px;

      margin-bottom:
        18px;
    }


    #cart-drawer
      .cart-drawer__summary {
      --cart-drawer-summary-padding:
        16px;

      gap:
        14px;

      padding:
        18px
        16px
        calc(
          18px
          +
          env(
            safe-area-inset-bottom
          )
        );
    }

  }


  /*
   * SMALL PHONES
   */

  @media screen and (max-width: 360px) {

    #cart-drawer
      .theme-drawer__header {
      min-height: 64px;

      padding-inline:
        13px;
    }


    #cart-drawer
      .theme-drawer__title {
      font-size: 21px;
    }


