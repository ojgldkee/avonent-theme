        {% if av_cb_subscription != blank %}
          <button class="av-cb__purchase-toggle" type="button" data-av-cb-purchase-toggle aria-pressed="false">
            <span data-av-cb-purchase-toggle-text>{{ av_cb_one_time_label | escape }} <strong data-av-cb-one-time-toggle-price>{{ av_cb_one_time_unit_price | money }}</strong> · {{ av_cb_shipping_note | escape }}</span>
          </button>
        {% endif %}
      </div>
    </div>
  </section>


  <div class="av-cb__top-stack">
    {% if av_cb_show_guarantee %}
    <div class="av-cb__guarantee-card" style="--guarantee-highlight: {{ av_cb_guarantee_color }}; --guarantee-text: #171717;" {% if av_cb_details_block %}{{ av_cb_details_block.shopify_attributes }}{% endif %}>
      <div class="av-cb__guarantee-image">
        {% if av_cb_guarantee_image != blank %}
          {{ av_cb_guarantee_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,180,240', alt: av_cb_guarantee_heading }}
        {% elsif av_cb_guarantee_image_url != blank %}
          <img src="{{ av_cb_guarantee_image_url | escape }}" width="240" height="240" loading="lazy" alt="{{ av_cb_guarantee_heading | escape }}">
        {% endif %}
      </div>
      <div class="av-cb__guarantee-copy">
        <h3>{{ av_cb_guarantee_heading }}</h3>
        <p><mark>{{ av_cb_guarantee_highlight }}</mark> {{ av_cb_guarantee_body }}</p>
      </div>
    </div>

    {% endif %}
    {% if av_cb_show_stock_notice %}
    <div class="av-cb__low-stock" style="--low-stock: {{ av_cb_stock_color }}; --low-stock-bg: {{ av_cb_stock_background }};">
      <div class="av-cb__low-stock-icon" aria-hidden="true">!</div>
      <div>
        <h3>{{ av_cb_stock_title }}</h3>
        <p>{{ av_cb_stock_text | escape }}</p>
      </div>
    </div>
    {% endif %}

    <div class="av-cb__accordion-list" data-av-cb-accordion-list>
      <details class="av-cb__accordion">
        <summary><span>{{ av_cb_acc_1_title }}</span><span class="av-cb__accordion-icon" aria-hidden="true"></span></summary>
        <div class="av-cb__accordion-body rte">{{ av_cb_acc_1_body | newline_to_br }}</div>
      </details>
      <details class="av-cb__accordion">
        <summary><span>{{ av_cb_acc_2_title }}</span><span class="av-cb__accordion-icon" aria-hidden="true"></span></summary>
        <div class="av-cb__accordion-body rte">{{ av_cb_acc_2_body | newline_to_br }}</div>
      </details>
      <details class="av-cb__accordion">
        <summary><span>{{ av_cb_acc_3_title }}</span><span class="av-cb__accordion-icon" aria-hidden="true"></span></summary>
        <div class="av-cb__accordion-body rte">{{ av_cb_acc_3_body | newline_to_br }}</div>
      </details>
    </div>

    {% if editor.settings.show_trust_image and av_cb_trust_image != blank %}
    <div class="av-cb__trust-image-section" style="margin-top:10px;">
      {% if av_cb_trust_image != blank %}
        <span style="display:block;width:100%;">{{ av_cb_trust_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 1200px, calc(100vw - 22px)', alt: av_cb_trust_image_alt, style: 'display:block;width:100%;height:auto;border-radius:18px;' }}</span>
      {% endif %}
    </div>
    {% endif %}

  </div>
{% if editor.settings.show_sticky_cart %}
<div class="av-cb__sticky" aria-label="Quick add to cart">
    <span class="av-cb__sticky-img">
      {% if av_cb_product.featured_image %}
        {{ av_cb_product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,90,120', alt: av_cb_product.title }}
      {% endif %}
    </span>
    <span class="av-cb__sticky-copy">
      <span class="av-cb__sticky-title">{{ editor.settings.sticky_title | default: av_cb_product.title | escape }}</span>
      <span class="av-cb__sticky-price" data-av-cb-sticky-price>{{ av_cb_subscription_unit_price | money }}</span>
    </span>
    <button class="av-cb__sticky-add" type="button" data-av-cb-sticky-add>{{ editor.settings.sticky_button_text | default: 'Add to Cart' | escape }}</button>
  </div>
{% endif %}

  <script>
    (() => {
      const initialize = () => {
      const root = document.querySelector('[data-av-cb]');
      document.documentElement.classList.add('av-cb-cinnamon-page');
      // Native Shopify Header controls the logo and navigation.
      // Announcement content is edited through Shopify header settings.
      // Shopify header navigation is configured in the header editor.
      if (!root) return;

      const fiveReasons = document.querySelector('[data-av-cb-five-reasons]');
      if (fiveReasons) {
        const fiveTrack = fiveReasons.querySelector('[data-av-cb-five-track]');
        const fiveCards = Array.from(fiveReasons.querySelectorAll('[data-av-cb-five-card]'));
        const fiveDots = Array.from(fiveReasons.querySelectorAll('[data-av-cb-five-dot]'));
        const fivePrev = fiveReasons.querySelector('[data-av-cb-five-prev]');
        const fiveNext = fiveReasons.querySelector('[data-av-cb-five-next]');
        let fiveIndex = 0;

        const renderFiveReasons = () => {
          if (!fiveTrack || !fiveCards.length) return;
          const cardWidth = fiveCards[0].getBoundingClientRect().width;
          const gap = parseFloat(getComputedStyle(fiveTrack).gap || '0');
          fiveTrack.style.transform = 'translate3d(' + (-(cardWidth + gap) * fiveIndex) + 'px,0,0)';
          fiveDots.forEach((dot, index) => dot.classList.toggle('is-active', index === fiveIndex));
        };

        const goFive = (index) => {
          fiveIndex = ((index % fiveCards.length) + fiveCards.length) % fiveCards.length;
          renderFiveReasons();
        };

        fivePrev?.addEventListener('click', () => goFive(fiveIndex - 1));
        fiveNext?.addEventListener('click', () => goFive(fiveIndex + 1));
        fiveDots.forEach((dot, index) => dot.addEventListener('click', () => goFive(index)));
        window.addEventListener('resize', renderFiveReasons, {passive:true});
        requestAnimationFrame(renderFiveReasons);
      }

      const extraReview = document.querySelector('[data-av-cb-extra-review]');
      const reviewReadMore = document.querySelector('[data-av-cb-review-read-more]');
      if (extraReview && reviewReadMore) {
        reviewReadMore.addEventListener('click', () => {
          const isOpen = reviewReadMore.getAttribute('aria-expanded') === 'true';

          extraReview.hidden = isOpen;
          reviewReadMore.setAttribute('aria-expanded', String(!isOpen));
          reviewReadMore.textContent = isOpen ? 'Read More Reviews' : 'Read Less Reviews';

          if (isOpen) {
            reviewReadMore.scrollIntoView({behavior:'smooth', block:'center'});
          }
        });
      }

      const subscriptionUnit = Number(root.dataset.subscriptionUnitPrice || 0);
      const subscriptionLabel = root.dataset.subscriptionLabel || 'Subscribe & Save';
      const oneTimeLabel = root.dataset.oneTimeLabel || 'One-Time Purchase';
      const shippingNote = root.dataset.shippingNote || '';
      const switchLabel = root.dataset.switchLabel || 'Switch back to Subscribe & Save';
      const oneTimeUnit = Number(root.dataset.oneTimeUnitPrice || 0);
      const oneTimeCompareUnit = Number(root.dataset.oneTimeCompareUnitPrice || 0);
      const qtyInput = root.querySelector('[data-av-cb-quantity]');
      const sellingPlanInput = root.querySelector('[data-av-cb-selling-plan]');
      const total = root.querySelector('[data-av-cb-price]');
      const topCompare = root.querySelector('[data-av-cb-compare-price]');
      const btnTotal = root.querySelector('[data-av-cb-button-price]');
      const btnCompare = root.querySelector('[data-av-cb-button-compare]');
      const stickyPrice = root.querySelector('[data-av-cb-sticky-price]');
      const refillRow = root.querySelector('.av-cb__refill-row');
      const purchaseToggle = root.querySelector('[data-av-cb-purchase-toggle]');
      const purchaseToggleText = root.querySelector('[data-av-cb-purchase-toggle-text]');
      const purchaseHeading = root.querySelector('[data-av-cb-purchase-heading]');
      const productForm = root.querySelector('form[data-type="add-to-cart-form"]');
      const variantInput = root.querySelector('input[ref="variantId"]');
      const bonusVariantId = Number(root.dataset.bonusVariantId || 0);
      const bundleButtons = Array.from(root.querySelectorAll('[data-av-cb-bundle]'));
      const subscriptionPerks = Array.from(root.querySelectorAll('[data-av-cb-subscription-perk]'));
      const bundleUnlocks = Array.from(root.querySelectorAll('[data-av-cb-bundle-unlock]'));
      const money = (cents) => new Intl.NumberFormat(document.documentElement.lang || 'en-US', {style:'currency', currency:root.dataset.currency || 'USD'}).format(Number(cents || 0) / 100);
      let purchaseMode = sellingPlanInput ? 'subscription' : 'one-time';

      const selectedBundle = () => root.querySelector('[data-av-cb-bundle].is-active') || bundleButtons[0];
      const valuesFor = (btn) => {
        const qty = Number(btn?.dataset.avCbBundle || 1);
        const isSubscription = purchaseMode === 'subscription' && sellingPlanInput;
        return {
          qty,
          price: Number(isSubscription ? btn?.dataset.subscriptionPrice : btn?.dataset.oneTimePrice) || 0,
          compare: Number(isSubscription ? btn?.dataset.subscriptionCompare : btn?.dataset.oneTimeCompare) || 0
        };
      };
      const setCompare = (el, value, base) => {
        if (!el) return;
        const show = Number(value) > Number(base);
        el.textContent = show ? money(value) : '';
        el.hidden = !show;
      };
      const renderMode = () => {
        const isSubscription = purchaseMode === 'subscription' && sellingPlanInput;
        if (sellingPlanInput) {
          sellingPlanInput.disabled = !isSubscription;
          if (isSubscription) sellingPlanInput.value = sellingPlanInput.dataset.planId || root.dataset.subscriptionPlanId || '';
        }
        if (refillRow) refillRow.hidden = !isSubscription;
        if (purchaseToggle) purchaseToggle.setAttribute('aria-pressed', String(!isSubscription));
        if (purchaseHeading) purchaseHeading.textContent = isSubscription ? subscriptionLabel : oneTimeLabel;

        bundleButtons.forEach((btn) => {
          const values = valuesFor(btn);
          const priceEl = btn.querySelector('[data-av-cb-bundle-price]');
          const compareEl = btn.querySelector('[data-av-cb-bundle-compare]');
          const titleEl = btn.querySelector('[data-av-cb-bundle-title]');
          const subtitleEl = btn.querySelector('[data-av-cb-bundle-subtitle]');
          if (priceEl) priceEl.textContent = money(values.price);
          setCompare(compareEl, values.compare, values.price);
          if (titleEl) titleEl.textContent = isSubscription ? titleEl.dataset.subscriptionTitle : titleEl.dataset.oneTimeTitle;
          if (subtitleEl) {
            const subtitle = isSubscription ? subtitleEl.dataset.subscriptionSubtitle : subtitleEl.dataset.oneTimeSubtitle;
            subtitleEl.textContent = subtitle || '';
            subtitleEl.hidden = !subtitle;
          }
        });

        const active = selectedBundle();
        const values = valuesFor(active);
        if (qtyInput) qtyInput.value = values.qty;
        if (total) total.textContent = money(values.price);
        if (btnTotal) btnTotal.textContent = money(values.price);
        if (stickyPrice) stickyPrice.textContent = money(values.price);
        setCompare(topCompare, values.compare, values.price);
        setCompare(btnCompare, values.compare, values.price);

        subscriptionPerks.forEach(perk => { perk.hidden = !isSubscription; });
        bundleUnlocks.forEach(unlock => {
          const card = unlock.closest('[data-av-cb-bundle]');
          unlock.hidden = !(isSubscription && card && card.classList.contains('is-active'));
        });

        if (purchaseToggleText) {
          if (isSubscription) {
            purchaseToggleText.textContent = oneTimeLabel + ' ';
            const amount = document.createElement('strong');
            amount.textContent = money(oneTimeUnit * values.qty);
            purchaseToggleText.append(amount, shippingNote ? ' · ' + shippingNote : '');
          }
          else {
            const subscriptionDisplayPrice = Number(active?.dataset.subscriptionPrice || 0);
            purchaseToggleText.textContent = switchLabel + ' — ';
            const amount = document.createElement('strong');
            amount.textContent = money(subscriptionDisplayPrice);
            purchaseToggleText.append(amount);
          }
        }
      };

      bundleButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          bundleButtons.forEach(x => x.classList.toggle('is-active', x === btn));
          renderMode();
        });
      });
      purchaseToggle?.addEventListener('click', () => {
        purchaseMode = purchaseMode === 'subscription' ? 'one-time' : 'subscription';
        renderMode();
      });

      const enableBundleSubmit = () => {
        const submitButton = productForm?.querySelector('button[type="submit"]');
        if (submitButton) submitButton.disabled = false;
      };

      // Safari/iOS can restore the page from the back-forward cache with the
      // button state exactly as it was before navigation. Always restore it.
      window.addEventListener('pageshow', enableBundleSubmit);

      const openUpdatedCartDrawer = async (sectionHtml, itemCount) => {
        // Keep the mounted theme-drawer/dialog in place. Replacing the entire
        // Shopify section destroys the open dialog and causes blank panels.
        if (!sectionHtml) {
          try {
            const rootPath = window.Shopify?.routes?.root || '/';
            const request = await fetch(rootPath + '?sections=cart-drawer-section', {
              credentials: 'same-origin', headers: {'Accept': 'application/json'}
            });
            const sectionData = await request.json();
            sectionHtml = sectionData['cart-drawer-section'] || '';
          } catch (error) {
            console.warn('[avonent] Could not refresh cart section', error);
          }
        }
        let refreshed = false;
        if (sectionHtml) {
          const parsed = new DOMParser().parseFromString(sectionHtml, 'text/html');
          const nextDrawer = parsed.querySelector('theme-drawer#cart-drawer');
          const currentDrawer = document.querySelector('theme-drawer#cart-drawer');
          const nextInner = nextDrawer?.querySelector('.cart-drawer__inner');
          const currentInner = currentDrawer?.querySelector('.cart-drawer__inner');
          const nextEmptyTemplate = nextDrawer?.querySelector('#empty-cart-template');
          const currentEmptyTemplate = currentDrawer?.querySelector('#empty-cart-template');
          if (nextInner && currentInner) {
            currentInner.replaceWith(nextInner);
            if (nextEmptyTemplate && currentEmptyTemplate) currentEmptyTemplate.replaceWith(nextEmptyTemplate);
            refreshed = true;
          }
        }
        if (!refreshed) {
          // Never leave customers looking at an empty overlay on a failed
          // section render. The full cart remains a working fallback.
          window.location.assign((window.Shopify?.routes?.root || '/') + 'cart');
          return;
        }

        if (Number.isFinite(itemCount)) {
          await customElements.whenDefined('cart-icon');
          document.querySelectorAll('cart-icon').forEach((icon) => {
            if (typeof icon.renderCartBubble === 'function') icon.renderCartBubble(itemCount, true);
          });
        }

        await customElements.whenDefined('theme-drawer');
        const drawer = document.querySelector('#cart-drawer');
        if (drawer && typeof drawer.open === 'function') {
          drawer.open();
        } else {
          document.querySelector('[data-testid="cart-drawer-trigger"]')?.click();
        }
      };

      productForm?.addEventListener('submit', async (event) => {
        // This custom cinnamon form owns the entire add flow. The theme's
        // built-in /handleSubmit binding is intentionally removed above so
        // one click can never add the paid subscription a second time.
        event.preventDefault();
        event.stopImmediatePropagation();

        const isSubscription = purchaseMode === 'subscription' && sellingPlanInput && !sellingPlanInput.disabled;
        const values = valuesFor(selectedBundle());
        const bonusQty = isSubscription && bonusVariantId ? (values.qty === 2 ? 1 : (values.qty === 3 ? 2 : 0)) : 0;

        const submitButton = productForm.querySelector('button[type="submit"]');
        const variantId = Number(variantInput?.value || 0);
        const sellingPlanId = sellingPlanInput?.value || sellingPlanInput?.dataset.planId || root.dataset.subscriptionPlanId || '';

        if (!variantId || (isSubscription && !sellingPlanId)) {
          enableBundleSubmit();
          return;
        }

        if (submitButton) submitButton.disabled = true;

        try {
          // Paid optional protection is added only by the customer's explicit
          // opt-in in the cart drawer, never silently during product add.
          const items = [];

          // Shopify displays newly-added lines in reverse insertion order.
          // Bonus goes in before the paid line so the paid cinnamon appears
          // above the $0 bonus in the drawer.
          if (bonusQty > 0) {
            items.push({
              id: bonusVariantId,
              quantity: bonusQty,
              properties: { '_Avonent bonus': 'First order free bottle' }
            });
          }

          // One-time digital gift for the Buy 3 subscription only.
          // The Shopify automatic BXGY discount makes this $24.99 item free
          // only when three paid cinnamon subscription units qualify.
          const ebookVariantId = Number(root.dataset.ebookVariantId || 0);
          if (isSubscription && values.qty === 3 && ebookVariantId) {
            items.push({
              id: ebookVariantId,
              quantity: 1,
              properties: { '_Avonent gift': 'Buy 3 first-order e-book' }
            });
          }

          const paidItem = {
            id: variantId,
            quantity: values.qty
          };

          if (isSubscription) {
            paidItem.selling_plan = sellingPlanId;
            if (bonusQty > 0) {
              paidItem.properties = {
                '_Avonent bundle': values.qty === 2 ? 'Buy 2 Get 1 Free' : 'Buy 3 Get 2 Free'
              };
            }
          }

          items.push(paidItem);

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              items,
              sections: 'cart-drawer-section',
              sections_url: window.location.pathname
            })
          });

          const result = await response.json().catch(() => ({}));
          if (!response.ok || result.status || result.errors) {
            throw new Error(result.description || result.message || 'Unable to add to cart.');
          }

          const finalCartResponse = await fetch('/cart.js', {
            headers: { 'Accept': 'application/json' },
            credentials: 'same-origin',
            cache: 'no-store'
          });
          const finalCart = finalCartResponse.ok ? await finalCartResponse.json() : null;

          await openUpdatedCartDrawer(
            result.sections?.['cart-drawer-section'] || '',
            finalCart ? Number(finalCart.item_count || 0) : NaN
          );
        } catch (error) {
          console.error('Avonent cinnamon add failed:', error);
          alert(error.message || 'Unable to add to cart. Please try again.');
        } finally {
          enableBundleSubmit();
        }
      }, { capture: true });

      renderMode();
      enableBundleSubmit();

      const deliveryDate = root.querySelector('[data-av-cb-delivery-date]');
      if (deliveryDate) {
        const date = new Date();
        date.setDate(date.getDate() + Math.max(1, Math.min(21, Number(root.dataset.deliveryDays) || 5)));
        const day = date.getDate();
        const mod100 = day % 100;
        const suffix = mod100 >= 11 && mod100 <= 13 ? 'th' : ({1:'st',2:'nd',3:'rd'}[day % 10] || 'th');
        deliveryDate.textContent = date.toLocaleDateString(document.documentElement.lang || 'en-US', {month:'long'}) + ' ' + day + suffix;
      }
      const soldBar = root.querySelector('[data-av-cb-sold]');
      if (soldBar && soldBar.dataset.avCbSoldReady !== 'true') {
        soldBar.dataset.avCbSoldReady = 'true';

        const soldFill = soldBar.querySelector('[data-av-cb-sold-fill]');
        const soldText = soldBar.querySelector('[data-av-cb-sold-text]');
        const soldStart = Math.max(0, Math.min(100, Number(soldBar.dataset.soldStart || 12)));
        const soldTarget = Math.max(soldStart, Math.min(100, Number(soldBar.dataset.soldTarget || 93)));

        let soldHasRun = false;

        const renderSold = (value) => {
          const clamped = Math.max(0, Math.min(100, value));
          soldBar.style.setProperty('--sold', clamped + '%');
          if (soldText) soldText.textContent = Math.round(clamped) + '% Sold';
        };

        const runSold = () => {
          if (soldHasRun) return;
          soldHasRun = true;
          soldBar.dataset.avCbSoldAnimated = 'true';

          const duration = 1800;
          const started = performance.now();

          const tick = (now) => {
            const progress = Math.min(1, (now - started) / duration);
            const eased = 1 - Math.pow(1 - progress, 3);
            const value = soldStart + ((soldTarget - soldStart) * eased);
            renderSold(value);

            if (progress < 1) {
              requestAnimationFrame(tick);
            } else {
              renderSold(soldTarget);
            }
          };

          requestAnimationFrame(tick);
        };

        renderSold(soldStart);

        if ('IntersectionObserver' in window) {
          const soldObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && !soldHasRun) {
                runSold();
                soldObserver.disconnect();
              }
            });
          }, {threshold: 0.2});

          soldObserver.observe(soldBar);

          if (soldBar.getBoundingClientRect().top < window.innerHeight && soldBar.getBoundingClientRect().bottom > 0) {
            requestAnimationFrame(runSold);
            soldObserver.disconnect();
          }
        } else {
          const onSoldScroll = () => {
            if (soldHasRun) return;
            const rect = soldBar.getBoundingClientRect();
            if (rect.top <= window.innerHeight * 0.9) {
              runSold();
              window.removeEventListener('scroll', onSoldScroll);
            }
          };

          window.addEventListener('scroll', onSoldScroll, {passive:true});
          onSoldScroll();
        }
      }

      const statsSections = document.querySelectorAll('[data-av-cb-stats]');
      const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      statsSections.forEach(section => {
        const numbers = section.querySelectorAll('.av-cb__stat-number');
        const run = () => {
          numbers.forEach(el => {
            if (el.dataset.animated === 'true') return;
            el.dataset.animated = 'true';
            const start = Number(el.dataset.start || 0);
            const end = Number(el.dataset.end || 0);
            const duration = Math.max(150, Number(el.dataset.duration || 1200));
            if (reduceMotion || start === end) {
              el.textContent = Math.round(end) + '%';
              return;
            }
            const started = performance.now();
            const tick = now => {
              const progress = Math.min(1, (now - started) / duration);
              const eased = 1 - Math.pow(1 - progress, 3);
              const value = Math.round(start + (end - start) * eased);
              el.textContent = value + '%';
              if (progress < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        };
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                run();
                observer.disconnect();
              }
            });
          }, {threshold:.28});
          observer.observe(section);
        } else {
          run();
        }
      });
      const carousels = document.querySelectorAll('[data-av-cb-carousel]');
      carousels.forEach(carousel => {
        const track = carousel.querySelector('[data-av-cb-carousel-track]');
        const cards = Array.from(carousel.querySelectorAll('[data-av-cb-carousel-card]'));
        const dots = Array.from(carousel.querySelectorAll('[data-av-cb-carousel-dot]'));
        const prev = carousel.querySelector('[data-av-cb-carousel-prev]');
        const next = carousel.querySelector('[data-av-cb-carousel-next]');
        if (!track || !cards.length) return;
        const setActive = index => dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
        const goTo = index => {
          const safe = Math.max(0, Math.min(cards.length - 1, index));
          track.scrollTo({left: cards[safe].offsetLeft - track.offsetLeft, behavior:'smooth'});
          setActive(safe);
        };
        const currentIndex = () => {
          const trackLeft = track.getBoundingClientRect().left;
          let best = 0;
          let distance = Infinity;
          cards.forEach((card, i) => {
            const d = Math.abs(card.getBoundingClientRect().left - trackLeft);
            if (d < distance) { distance = d; best = i; }
          });
          return best;
        };
        prev?.addEventListener('click', () => goTo(currentIndex() - 1));
        next?.addEventListener('click', () => goTo(currentIndex() + 1));
        dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
        let scrollTimer;
        track.addEventListener('scroll', () => {
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(() => setActive(currentIndex()), 80);
        }, {passive:true});
      });
      const scienceSections = document.querySelectorAll('[data-av-cb-science]');
      scienceSections.forEach(section => {
        const cards = Array.from(section.querySelectorAll('.av-cb__science-card'));
        cards.forEach(card => {
          card.addEventListener('toggle', () => {
            if (!card.open) return;
            cards.forEach(other => {
              if (other !== card) other.open = false;
            });
          });
        });
      });
      const faqSection = document.querySelector('[data-av-cb-faq]');
      if (faqSection) {
        const faqItems = Array.from(faqSection.querySelectorAll('.av-cb__faq-item'));
        faqItems.forEach(item => {
          item.addEventListener('toggle', () => {
            if (!item.open) return;
            faqItems.forEach(other => {
              if (other !== item) other.open = false;
            });
          });
        });
      }
      const stickyBar = root.querySelector('.av-cb__sticky');
      const firstAddToCart = root.querySelector('.av-cb__buy');
      if (stickyBar && firstAddToCart) {
        let stickyTicking = false;
        const updateStickyVisibility = () => {
          stickyBar.classList.toggle('is-visible', firstAddToCart.getBoundingClientRect().bottom < 0);
          stickyTicking = false;
        };
        const requestStickyUpdate = () => {
          if (stickyTicking) return;
          stickyTicking = true;
          requestAnimationFrame(updateStickyVisibility);
        };
        updateStickyVisibility();
        window.addEventListener('scroll', requestStickyUpdate, {passive:true});
        window.addEventListener('resize', requestStickyUpdate, {passive:true});
      }

      const stickyAdd = root.querySelector('[data-av-cb-sticky-add]');
      if (stickyAdd) {
        stickyAdd.addEventListener('click', () => {
          const top = root.querySelector('#av-cb-top');
          top?.scrollIntoView({behavior:'smooth', block:'start'});
        });
      }

      const accordions = root.querySelectorAll('.av-cb__accordion');
      accordions.forEach(item => {
        item.addEventListener('toggle', () => {
          if (!item.open) return;
          accordions.forEach(other => {
            if (other !== item) other.open = false;
          });
        });
      });
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initialize, {once:true});
      else initialize();
    })();
  </script>
</div>

<script>
/* AVONENT GALLERY BEHAVIOR */
(() => {
  const init = (gallery) => {
    if (!gallery || gallery.dataset.avCbGalleryReady === 'true') return;
    gallery.dataset.avCbGalleryReady = 'true';

    const track = gallery.querySelector('[data-av-cb-gallery-track]');
    const slides = Array.from(gallery.querySelectorAll('[data-av-cb-gallery-slide]'));
    const thumbs = Array.from(gallery.querySelectorAll('[data-av-cb-gallery-thumb]'));
    const prev = gallery.querySelector('[data-av-cb-gallery-prev]');
    const next = gallery.querySelector('[data-av-cb-gallery-next]');
    if (!track || slides.length < 1) return;

    let activeIndex = 0;
    let scrollTimer;

    const setActive = (index) => {
      activeIndex = ((index % slides.length) + slides.length) % slides.length;
      thumbs.forEach((thumb, i) => thumb.classList.toggle('is-active', i === activeIndex));
    };

    const goTo = (index) => {
      const nextIndex = ((index % slides.length) + slides.length) % slides.length;
      track.scrollTo({ left: slides[nextIndex].offsetLeft, behavior: 'smooth' });
      setActive(nextIndex);
    };

    prev?.addEventListener('click', () => goTo(activeIndex - 1));
    next?.addEventListener('click', () => goTo(activeIndex + 1));
    thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => goTo(i)));

    track.addEventListener('scroll', () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        const left = track.scrollLeft;
        let closest = 0;
        let distance = Infinity;
        slides.forEach((slide, i) => {
          const d = Math.abs(slide.offsetLeft - left);
          if (d < distance) { distance = d; closest = i; }
        });
        setActive(closest);
      }, 70);
    }, { passive: true });
  };

  const run = () => document.querySelectorAll('[data-av-cb-gallery]').forEach(init);
  run();
  document.addEventListener('shopify:section:load', run);
})();
</script>