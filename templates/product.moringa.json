    "00_avonent_research_benefits_WGiEnm": {
      "type": "00-avonent-research-benefits",
      "name": "Avonent benefit flips",
      "settings": {
        "heading_accent": "Real Benefits.",
        "heading_rest": "Backed by Research.",
        "subheading": "<p>One plant. Multiple reasons people take it every day.</p>",
        "card_1_image": "shopify://shop_images/54BA8953-968C-4EC2-87D2-80955CC9C583.png",
        "card_1_icon": "energy",
        "card_1_title": "Energy",
        "card_1_front": "Support steady everyday energy without another coffee.",
        "card_1_back": "Moringa leaf brings a broad mix of micronutrients and plant compounds into one simple routine. Those nutrients support normal energy metabolism, making it an easy daily way to support steady energy without adding another stimulant.†",
        "card_2_image": "shopify://shop_images/E7AF9E64-8AA3-4DD0-9FD8-316F0DB0604E.png",
        "card_2_icon": "aging",
        "card_2_title": "Aging",
        "card_2_front": "Support strength, mobility, and resilience as the years add up.†",
        "card_2_back": "Healthy aging is about giving your body consistent nutritional support over time. Moringa provides micronutrients and antioxidant phytonutrients that support cellular defense, everyday resilience, and an active lifestyle as the years add up.†",
        "card_3_image": "shopify://shop_images/0D358947-7BFD-484E-ADCE-4E7D5BB64395.png",
        "card_3_icon": "metabolic",
        "card_3_title": "Metabolism",
        "card_3_front": "Support healthy glucose metabolism and everyday energy use.†",
        "card_3_back": "Human studies have explored moringa leaf and markers involved in glucose and metabolic health. The research is still developing, but its nutrient and polyphenol profile makes it a compelling addition to a balanced metabolic-wellness routine.†",
        "card_4_image": "shopify://shop_images/0DE44C5F-B261-44E0-9E4A-DBFB50BF3743.png",
        "card_4_icon": "antioxidants",
