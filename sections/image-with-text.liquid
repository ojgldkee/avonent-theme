{% liquid
  assign desktop_image = section.settings.image | default: section.settings.mobile_image
  assign mobile_image = section.settings.mobile_image
  assign image_alt = section.settings.alt_text | default: desktop_image.alt
%}
<style>
  #shopify-section-{{ section.id }} .av-image-text {
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding }}px 16px;
  }
  #shopify-section-{{ section.id }} .av-image-text__wrap {
    width: min(100%, 1200px);
    margin: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .av-image-text__wrap--right .av-image-text__media {order:2}
  #shopify-section-{{ section.id }} .av-image-text__media {min-width:0;overflow:hidden;border-radius:{{ section.settings.radius }}px}
  #shopify-section-{{ section.id }} .av-image-text__media img,
  #shopify-section-{{ section.id }} .av-image-text__media svg {display:block;width:100%;height:auto}
  #shopify-section-{{ section.id }} .av-image-text__copy {max-width:550px}
  #shopify-section-{{ section.id }} .av-image-text__eyebrow {font-size:12px;text-transform:uppercase;letter-spacing:.12em;font-weight:750;margin:0 0 12px;color:{{ section.settings.accent }}}
  #shopify-section-{{ section.id }} .av-image-text h2 {font-size:clamp(27px,3vw,42px);line-height:1.12;letter-spacing:-.035em;margin:0 0 18px;color:inherit}
  #shopify-section-{{ section.id }} .av-image-text__body {font-size:16px;line-height:1.6}
  #shopify-section-{{ section.id }} .av-image-text__body p {margin:0 0 14px}
  #shopify-section-{{ section.id }} .av-image-text__button {display:inline-flex;align-items:center;justify-content:center;margin-top:20px;background:{{ section.settings.accent }};color:#fff;text-decoration:none;border-radius:12px;font-weight:750;padding:13px 22px}
  @media (max-width:749px) {
    #shopify-section-{{ section.id }} .av-image-text {padding:{{ section.settings.mobile_padding }}px 12px}
    #shopify-section-{{ section.id }} .av-image-text__wrap {grid-template-columns:1fr;gap:24px}
    #shopify-section-{{ section.id }} .av-image-text__wrap--right .av-image-text__media {order:0}
  }
</style>
<div class="av-image-text">
  <div class="av-image-text__wrap{% if section.settings.image_position == 'right' %} av-image-text__wrap--right{% endif %}">
    <div class="av-image-text__media">
      {% if desktop_image != blank %}
        <picture>
          {% if mobile_image != blank %}
            <source media="(max-width:749px)" srcset="{{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 900 }} 900w" sizes="100vw">
          {% endif %}
          {{ desktop_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,600,900,1200,1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: image_alt }}
        </picture>
      {% elsif request.design_mode %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>
    <div class="av-image-text__copy">
      {% if section.settings.eyebrow != blank %}<p class="av-image-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.body != blank %}<div class="av-image-text__body rte">{{ section.settings.body }}</div>{% endif %}
      {% if section.settings.button_text != blank and section.settings.button_link != blank %}
        <a class="av-image-text__button" href="{{ section.settings.button_link }}">{{ section.settings.button_text | escape }}</a>
      {% endif %}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"image_picker","id":"mobile_image","label":"Mobile image (optional)"},
    {"type":"text","id":"alt_text","label":"Alt text"},
    {"type":"select","id":"image_position","label":"Image position","options":[
      {"value":"left","label":"Left"},{"value":"right","label":"Right"}
    ],"default":"left"},
    {"type":"text","id":"eyebrow","label":"Small text"},
    {"type":"text","id":"heading","label":"Heading","default":"Your heading"},
    {"type":"richtext","id":"body","label":"Text","default":"<p>Use this space to explain a benefit or tell your story.</p>"},
    {"type":"text","id":"button_text","label":"Button text"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"color","id":"background","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text color","default":"#171513"},
    {"type":"color","id":"accent","label":"Accent color","default":"#A84F1B"},
    {"type":"range","id":"radius","label":"Image corners","min":0,"max":40,"step":2,"unit":"px","default":16},
    {"type":"range","id":"gap","label":"Column gap","min":0,"max":80,"step":4,"unit":"px","default":48},
    {"type":"range","id":"padding","label":"Top / bottom spacing","min":0,"max":120,"step":4,"unit":"px","default":48},
    {"type":"range","id":"mobile_padding","label":"Mobile spacing","min":0,"max":80,"step":4,"unit":"px","default":24}
  ],
  "presets":[{"name":"Image with text","category":"Media"}]
}
{% endschema %}