{% liquid
  assign desktop_image = section.settings.desktop_image | default: section.settings.mobile_image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
%}
<section id="AvonentHero-{{ section.id }}" class="avonent-home-hero"
  style="--av-hero-height:{{ section.settings.desktop_height }}px;--av-hero-mobile-height:{{ section.settings.mobile_height }}px;--av-hero-text:{{ section.settings.text_color }};--av-hero-button-bg:{{ section.settings.button_background }};--av-hero-button-text:{{ section.settings.button_text_color }};--av-hero-stars:{{ section.settings.star_color }};--av-hero-position:{{ section.settings.background_position | escape }};">
  <div class="avonent-home-hero__media" aria-hidden="true">
    {% if desktop_image != blank %}
      {{ desktop_image | image_url: width: 2400 | image_tag: class: 'avonent-home-hero__image avonent-home-hero__image--desktop', loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,2000,2400', sizes: '100vw' }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'avonent-home-hero__placeholder' }}
    {% endif %}
    {% if mobile_image != blank %}
      {{ mobile_image | image_url: width: 1400 | image_tag: class: 'avonent-home-hero__image avonent-home-hero__image--mobile', loading: 'eager', fetchpriority: 'high', widths: '375,550,750,900,1200,1400', sizes: '100vw' }}
    {% endif %}
  </div>
  <div class="avonent-home-hero__shade" aria-hidden="true"></div>
  <div class="avonent-home-hero__inner">
    <div class="avonent-home-hero__content">
      {% if section.settings.show_social_proof %}
        <div class="avonent-home-hero__social-proof">
          <span class="avonent-home-hero__stars" aria-label="{{ section.settings.star_rating }} out of 5 stars">{% for i in (1..5) %}{% render "avonent-fa-star" %}{% endfor %}</span>
          <span>{{ section.settings.customer_text | escape }}</span>
        </div>
      {% endif %}
      {% if section.settings.eyebrow != blank %}<p class="avonent-home-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h1 class="avonent-home-hero__heading">{{ section.settings.heading | escape }}</h1>{% endif %}
      {% if section.settings.description != blank %}<div class="avonent-home-hero__description rte">{{ section.settings.description }}</div>{% endif %}
      {% if section.settings.button_text != blank %}
        <a class="avonent-home-hero__button" href="{{ section.settings.button_link | default: '/collections/all' }}">
          <span>{{ section.settings.button_text | escape }}</span>
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
      {% if section.settings.show_guarantee_line and section.settings.guarantee_text != blank %}
        <div class="avonent-home-hero__guarantee">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 19 6v5c0 4.8-2.8 8.2-7 10-4.2-1.8-7-5.2-7-10V6z" stroke="currentColor" stroke-width="1.8"/><path d="M8.7 12.1 10.8 14.2 15.3 9.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ section.settings.guarantee_text | escape }}
        </div>
      {% endif %}
    </div>
  </div>
</section>
{% stylesheet %}
  .avonent-home-hero {position:relative;isolation:isolate;display:flex;align-items:center;width:100%;min-height:var(--av-hero-height,650px);overflow:hidden;background:#082A45;color:var(--av-hero-text,#fff)}
  .avonent-home-hero *{box-sizing:border-box}
  .avonent-home-hero__media,.avonent-home-hero__shade{position:absolute;inset:0;z-index:-2;overflow:hidden}
  .avonent-home-hero__image,.avonent-home-hero__placeholder{display:block;width:100%;height:100%;min-height:100%;object-fit:cover;object-position:var(--av-hero-position,center center)}
  .avonent-home-hero__image--mobile{display:none}
  .avonent-home-hero__shade{z-index:-1;background:linear-gradient(90deg,rgba(2,18,38,.90) 0%,rgba(3,28,51,.78) 33%,rgba(2,28,52,.42) 62%,rgba(3,22,40,.12) 100%)}
  .avonent-home-hero__inner{width:calc(100% - 72px);max-width:1300px;margin:0 auto;padding:72px 0}
  .avonent-home-hero__content{display:flex;flex-direction:column;align-items:flex-start;width:min(100%,650px);text-align:left}
  .avonent-home-hero__social-proof{display:flex;align-items:center;gap:12px;color:#fff;font-size:14px;margin-bottom:18px}
  .avonent-home-hero__stars{display:flex;align-items:center;gap:3px;color:var(--av-hero-stars,#ffd160)} .avonent-home-hero__stars svg{width:17px;height:17px;flex:0 0 17px}
  .avonent-home-hero__eyebrow{font-size:13px;letter-spacing:.13em;text-transform:uppercase;font-weight:750;color:#B5F1FD;margin:0 0 19px}
  .avonent-home-hero__heading{margin:0;color:inherit;font-family:var(--font-heading--family);font-size:clamp(46px,5.5vw,83px);font-weight:760;letter-spacing:-.047em;line-height:1.045;text-wrap:balance;text-shadow:0 2px 16px rgba(0,0,0,.16)}
  .avonent-home-hero__description{max-width:585px;margin:22px 0 0;color:rgba(244,252,255,.92);font-size:clamp(16px,1.55vw,20px);line-height:1.55}
  .avonent-home-hero__description p{margin:0;color:inherit;line-height:inherit}
  .avonent-home-hero__button,.avonent-home-hero__button:visited{display:flex;align-items:center;justify-content:center;gap:14px;width:min(100%,530px);min-height:50px;padding:10px 24px;margin-top:26px;text-align:center;background:var(--av-hero-button-bg,#02C6EA);color:var(--av-hero-button-text,#061E2B)!important;border-radius:10px;text-decoration:none!important;font-size:clamp(17px,1.6vw,22px);font-weight:800;box-shadow:0 12px 25px rgba(2,12,26,.28);transition:transform .2s cubic-bezier(.16,1,.3,1),filter .2s cubic-bezier(.16,1,.3,1)}
  .avonent-home-hero__button:hover{filter:brightness(1.09);transform:translateY(-2px)}
  .avonent-home-hero__button:active{transform:scale(.97)}
  .avonent-home-hero__button:focus-visible{outline:3px solid #fff;outline-offset:3px}
  .avonent-home-hero__guarantee{display:flex;align-items:center;gap:9px;margin-top:17px;color:#EAF9FD;font-size:14px}
  .avonent-home-hero__guarantee svg{width:20px;height:20px;flex:0 0 20px;color:#53E6FC}
  @media (min-width: 750px) {
    .avonent-home-hero {
      min-height: clamp(360px, 44vw, var(--av-hero-height, 650px));
    }

    .avonent-home-hero__inner {
      padding-block: clamp(32px, 5vw, 72px);
    }
  }

  @media (min-width: 750px) and (max-height: 800px) {
    .avonent-home-hero {
      min-height: clamp(360px, 68vh, var(--av-hero-height, 650px));
      min-height: max(360px, min(44vw, 68vh, var(--av-hero-height, 650px)));
    }

    .avonent-home-hero__inner {
      padding-block: clamp(28px, 6vh, 48px);
    }
  }

  @media(max-width:749px){
    .avonent-home-hero{min-height:var(--av-hero-mobile-height,700px);align-items:flex-start}
    .avonent-home-hero__image--desktop{display:none}
    .avonent-home-hero__image--mobile{display:block}
    .avonent-home-hero__image{object-position:50% 53%}
    .avonent-home-hero__shade{background:linear-gradient(180deg,rgba(3,22,43,.88) 0%,rgba(3,22,43,.72) 39%,rgba(3,27,46,.38) 68%,rgba(3,27,46,.12) 100%)}
    .avonent-home-hero__inner{width:calc(100% - 38px);max-width:600px;padding:60px 0 72px}
    .avonent-home-hero__content{width:100%}
    .avonent-home-hero__heading{font-size:clamp(39px,9.8vw,54px);line-height:1.08}
    .avonent-home-hero__description{font-size:16px;margin-top:17px}
    .avonent-home-hero__button{margin-top:24px;min-height:48px;font-size:16px;width:100%}
    .avonent-home-hero__social-proof{font-size:13px;flex-wrap:wrap}
  }
  @media(prefers-reduced-motion:reduce){.avonent-home-hero__button{transition:none}.avonent-home-hero__button:hover{transform:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "00 Avonent Home Hero",
  "tag": "section",
  "class": "avonent-home-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text above heading",
      "default": "PREMIUM DAILY WELLNESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feel Better. Live Sharper."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Premium formulas made for the routines that matter.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_button_arrow",
      "label": "Show arrow",
      "default": false
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "90-Day Money-Back Guarantee"
    },
    {
      "type": "header",
      "content": "Customer proof"
    },
    {
      "type": "checkbox",
      "id": "show_social_proof",
      "label": "Show customer proof",
      "default": true
    },
    {
      "type": "range",
      "id": "star_rating",
      "label": "Star rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "number",
      "id": "counter_start",
      "label": "Counter starting number",
      "default": 8500
    },
    {
      "type": "number",
      "id": "counter_end",
      "label": "Counter ending number",
      "default": 10000
    },
    {
      "type": "text",
      "id": "counter_suffix",
      "label": "Number suffix",
      "default": "+"
    },
    {
      "type": "text",
      "id": "customer_text",
      "label": "Text after number",
      "default": "Trusted Customers"
    },
    {
      "type": "range",
      "id": "counter_duration",
      "label": "Count animation duration",
      "min": 500,
      "max": 4000,
      "step": 100,
      "unit": "ms",
      "default": 1600
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#02C6EA"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "Vertical position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 450,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 500,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 720
    },
    {
      "type": "checkbox",
      "id": "show_guarantee_line",
      "label": "Show guarantee text inside hero",
      "default": false
    },
    {
      "type": "text",
      "id": "background_position",
      "label": "Desktop image focus (CSS value)",
      "default": "center center"
    }
  ],
  "presets": [
    {
      "name": "00 Avonent Home Hero"
    }
  ]
}
{% endschema %}
