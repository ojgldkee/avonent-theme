   .avonent-health-gallery {width:100%;overflow:hidden;background:var(--av-gallery-bg,#F7FBFD);padding:clamp(30px,4vw,54px) 0 clamp(42px,5vw,65px);color:#102A41;}
  .avonent-health-gallery *{box-sizing:border-box}
  .avonent-health-gallery__inner{width:min(100% - 52px,1220px);margin:0 auto}
  .avonent-health-gallery__head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:16px}
  .avonent-health-gallery__copy{min-width:0}
  .avonent-health-gallery__eyebrow{margin:0 0 10px;font-size:12px;font-weight:700;letter-spacing:.12em;color:#0A8EB2;text-transform:uppercase}
  .avonent-health-gallery__head h2{margin:0;color:#0A2942;font-size:clamp(37px,4.6vw,62px);font-weight:770;letter-spacing:-.048em;line-height:1.06;text-wrap:balance}
  .avonent-health-gallery__head h2 .avonent-health-gallery__intro,.avonent-health-gallery__head h2 .avonent-health-gallery__accent{display:block;white-space:nowrap}
  .avonent-health-gallery__head h2 .avonent-health-gallery__accent{color:#02C6EA;}
  .avonent-health-gallery__description{margin:8px 0 0;color:#466175;font-size:clamp(17px,2vw,23px);line-height:1.4;max-width:650px}
  .avonent-health-gallery__controls{display:flex;align-items:center;gap:10px;flex:none;padding-bottom:6px}
  .avonent-health-gallery__arrow{display:inline-flex;align-items:center;justify-content:center;width:47px;height:47px;border-radius:50%;background:#fff;border:1px solid #B9D9E7;color:#0A314A;cursor:pointer;transition:transform .15s cubic-bezier(.16,1,.3,1),background-color .15s cubic-bezier(.16,1,.3,1)}
  .avonent-health-gallery__arrow:hover:not(:disabled){background:#C7F5FF}
  .avonent-health-gallery__arrow:active:not(:disabled){transform:scale(.93)}
  .avonent-health-gallery__arrow:disabled{opacity:.4;cursor:default}
  .avonent-health-gallery__arrow:focus-visible{outline:3px solid #02C6EA;outline-offset:2px}
  .avonent-health-gallery__rail{display:flex;align-items:stretch;gap:18px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scroll-padding-left:0;scroll-behavior:smooth;overscroll-behavior-inline:contain;scrollbar-width:none;padding:0 0 10px;touch-action:pan-x pan-y}
  .avonent-health-gallery__rail::-webkit-scrollbar{display:none}
  .avonent-health-gallery__slide{flex:0 0 clamp(310px,42%,530px);scroll-snap-align:start;scroll-snap-stop:always;min-width:0;background:#D9F2F9;border-radius:17px;overflow:hidden;box-shadow:0 7px 24px rgba(6,62,99,.07);border:1px solid #D6EBF4}
  .avonent-health-gallery__image,.avonent-health-gallery__placeholder{display:block;width:100%;height:auto;aspect-ratio:1.27/1;object-fit:cover}
  .avonent-health-gallery__placeholder{background:linear-gradient(135deg,#DAF6FF,#C8EDF7)}
  .avonent-health-gallery__placeholder svg{width:100%;height:100%}
  .avonent-health-gallery__caption{padding:17px 22px 20px;color:#15354C;font-size:16px;font-weight:710}
  .avonent-health-gallery__pagination{display:flex;align-items:center;justify-content:center;gap:2px;margin-top:9px}
  .avonent-health-gallery__dot{display:grid;place-items:center;flex:0 0 44px;width:44px;height:44px;padding:0;border:0;border-radius:999px;background:transparent;color:inherit;cursor:pointer;appearance:none;-webkit-tap-highlight-color:transparent}
  .avonent-health-gallery__dot::after{content:"";display:block;width:9px;height:9px;border-radius:999px;background:#B6C9D2;transition:width .2s ease,background-color .2s ease}
  .avonent-health-gallery__dot.is-active::after{width:30px;background:#02C6EA}
  .avonent-health-gallery__dot:focus-visible{outline:2px solid #048BB2;outline-offset:-5px}
  @media(prefers-reduced-motion:reduce){.avonent-health-gallery__dot::after{transition:none}}
