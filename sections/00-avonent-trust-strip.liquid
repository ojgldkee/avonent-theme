<section
  class="avonent-trust-strip"
  style="
    --av-trust-bg: {{ section.settings.background_color }};
    --av-trust-text: {{ section.settings.text_color }};
    --av-trust-accent: {{ section.settings.accent_color }};
    --av-trust-padding-top: {{ section.settings.padding_top }}px;
    --av-trust-padding-bottom: {{ section.settings.padding_bottom }}px;
    --av-trust-speed: {{ section.settings.speed | default: 18 }}s;
  "
>
  <div class="avonent-trust-strip__viewport" aria-label="Avonent store benefits">
    <div class="avonent-trust-strip__track">
      {% for repeat_i in (1..6) %}
        <div class="avonent-trust-strip__group"{% if repeat_i != 1 %} aria-hidden="true"{% endif %}>
          {% for block in section.blocks %}
            {% if block.type == 'trust_item' %}
            <div
              class="avonent-trust-strip__item"
              {% if repeat_i == 1 %}{{ block.shopify_attributes }}{% endif %}
            >
              <div class="avonent-trust-strip__icon">
                {% case block.settings.icon %}
                  {% when 'check' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"></circle>
                      <path d="M8.3 12.1 10.7 14.5 15.8 9.5"></path>
                    </svg>
                  {% when 'shield' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 3 19 6v5c0 4.8-2.8 8.2-7 10-4.2-1.8-7-5.2-7-10V6z"></path>
                      <path d="M9 12.1 11.1 14.2 15.3 10"></path>
                    </svg>
                  {% when 'lab' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M9 3h6"></path>
                      <path d="M10 3v6l-5 8.2A2.4 2.4 0 0 0 7 21h10a2.4 2.4 0 0 0 2-3.8L14 9V3"></path>
                      <path d="M8.5 14h7"></path>
                    </svg>
                  {% when 'flag' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6 3v18"></path>
                      <path d="M6 4h10l-2 3 2 3H6"></path>
                    </svg>
                  {% when 'truck' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M3 6h11v9H3z"></path>
                      <path d="M14 10h3.5L21 13v2h-7z"></path>
                      <circle cx="8" cy="17" r="1.7"></circle>
                      <circle cx="18" cy="17" r="1.7"></circle>
                    </svg>
                  {% when 'star' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="m12 3 2.7 5.5 6 .9-4.4 4.2 1 6-5.3-2.8-5.3 2.8 1-6-4.4-4.2 6-.9z"></path>
                    </svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"></circle>
                      <path d="M8.3 12.1 10.7 14.5 15.8 9.5"></path>
                    </svg>
                {% endcase %}
              </div>

              <div class="avonent-trust-strip__text">
                {{ block.settings.text }}
              </div>
            </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>


<section id="AvonentHealthGallery-{{ section.id }}" class="avonent-health-gallery" aria-labelledby="AvonentHealthGalleryHeading-{{ section.id }}" style="--av-gallery-bg:{{ section.settings.gallery_background_color }};">
  <div class="avonent-health-gallery__inner">
    <div class="avonent-health-gallery__head">
      <div class="avonent-health-gallery__copy">
        {% if section.settings.gallery_eyebrow != blank %}<p class="avonent-health-gallery__eyebrow">{{ section.settings.gallery_eyebrow | escape }}</p>{% endif %}
        <h2 id="AvonentHealthGalleryHeading-{{ section.id }}"><span class="avonent-health-gallery__intro">{{ section.settings.gallery_heading | escape }}</span><span class="avonent-health-gallery__accent">{{ section.settings.gallery_heading_accent | default: 'Support Your Health' | escape }}</span></h2>
        <p class="avonent-health-gallery__description">{{ section.settings.gallery_description | escape }}</p>
      </div>

    </div>
    <div class="avonent-health-gallery__rail" data-av-gallery-rail tabindex="0" aria-label="Swipe to browse Avonent products">
      {% for block in section.blocks %}
        {% if block.type == 'product_card' %}
          {% liquid
            assign av_card_product = block.settings.product
            assign av_card_image = block.settings.card_image
            if av_card_product != blank and av_card_product.featured_image != blank
              assign av_card_image = av_card_product.featured_image
            endif
            assign av_card_url = block.settings.button_link
            if av_card_product != blank
              assign av_card_url = av_card_product.url
            endif
            if av_card_url == blank
              assign av_card_url = '/collections/all'
            endif
          %}
          <article class="avonent-health-gallery__slide avonent-health-gallery__product" {{ block.shopify_attributes }}>
            <a class="avonent-health-gallery__media-link" href="{{ av_card_url }}" tabindex="-1" aria-hidden="true">
              {% if av_card_image != blank %}
                {{ av_card_image | image_url: width: 1000 | image_tag: class: 'avonent-health-gallery__image', loading: 'lazy', widths: '360,520,720,1000', sizes: '(max-width: 749px) 82vw, 44vw', alt: block.settings.image_alt }}
              {% else %}
                {% render 'avonent-product-pack-illustration', kind: block.settings.pack_style, uid: block.id %}
              {% endif %}
            </a>
            <div class="avonent-health-gallery__product-body">
              <div class="avonent-health-gallery__rating">
                <span class="avonent-health-gallery__stars" aria-label="Five gold stars">
                  {% for star_i in (1..5) %}{% render 'avonent-fa-star' %}{% endfor %}
                </span>
                <span>{{ section.settings.rating_prefix | escape }} <strong>{{ block.settings.rating | escape }} / 5.0</strong></span>
              </div>
              <h3 class="avonent-health-gallery__product-title">{% if av_card_product != blank %}{{ av_card_product.title | escape }}{% else %}{{ block.settings.title | escape }}{% endif %}</h3>
              {% if block.settings.description != blank %}<p class="avonent-health-gallery__product-description">{{ block.settings.description | escape }}</p>{% endif %}
              <div class="avonent-health-gallery__product-price">
                {% if av_card_product != blank %}
                  {{ av_card_product.price | money }}
                {% else %}
                  {{ block.settings.example_price | escape }}
                {% endif %}
              </div>
              <a class="avonent-health-gallery__product-cta" href="{{ av_card_url }}"><span>{{ block.settings.button_text | escape }}</span><span aria-hidden="true">→</span></a>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    <div class="avonent-health-gallery__pagination" role="group" aria-label="Product carousel pagination">
      {% assign av_dot_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'product_card' %}
          {% assign av_dot_index = av_dot_index | plus: 1 %}
          <button type="button" class="avonent-health-gallery__dot{% if av_dot_index == 1 %} is-active{% endif %}" data-av-gallery-dot aria-label="Show {{ block.settings.title | default: 'product' | escape }}"{% if av_dot_index == 1 %} aria-pressed="true"{% else %} aria-pressed="false"{% endif %}></button>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
(function(){
  var root=document.getElementById('AvonentHealthGallery-{{ section.id }}');
  if(!root||root.dataset.galleryReady==='yes')return;
  root.dataset.galleryReady='yes';
  var rail=root.querySelector('[data-av-gallery-rail]');
  var slides=Array.prototype.slice.call(rail.querySelectorAll('.avonent-health-gallery__slide'));
  var dots=Array.prototype.slice.call(root.querySelectorAll('[data-av-gallery-dot]'));
  if(!slides.length)return;
  function currentIndex(){
    var best=0,dist=Infinity;
    slides.forEach(function(el,idx){var delta=Math.abs(el.offsetLeft-rail.offsetLeft-rail.scrollLeft);if(delta<dist){dist=delta;best=idx;}});
    return best;
  }
  function update(){
    var i=currentIndex();
    dots.forEach(function(dot,idx){
      var active=idx===i;
      dot.classList.toggle('is-active',active);
      dot.setAttribute('aria-pressed',active?'true':'false');
    });
  }
  function jumpTo(index){
    if(!slides[index])return;
    var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    rail.scrollTo({left:slides[index].offsetLeft-rail.offsetLeft,behavior:reduce?'auto':'smooth'});
  }
  dots.forEach(function(dot,index){dot.addEventListener('click',function(){jumpTo(index);});});
  rail.addEventListener('scroll',update,{passive:true});
  window.addEventListener('resize',update);
  update();
})();
</script>

<div class="avonent-faq-proofs" id="AvonentFaqProofs-{{ section.id }}">
