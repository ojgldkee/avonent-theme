    .avonent-guarantee__content h2 { font-size: clamp(34px,8.5vw,44px); line-height: 1.11; margin-bottom: 17px; }
    .avonent-guarantee__description { font-size: 15px; line-height: 1.55; }
    .avonent-guarantee__features { gap: 9px; margin: 24px auto 27px; }
    .avonent-guarantee__chip { padding: 10px 12px; min-height: 40px; font-size: 12.5px; gap: 7px; }
    .avonent-guarantee__chip > span { width: 19px; height: 19px; flex-basis: 19px; }
    .avonent-guarantee__button { min-height: 57px; font-size: 17px; padding: 13px 17px; }
