  /* 90-day money-back guarantee card — editable background image and image badge. */

  /* Avonent guarantee: positioned after FAQ, before four trust cards. */
  .avonent-guarantee-section {
    position: relative;
    width: 100%;
    padding: clamp(118px, 12vw, 153px) 0 0;
    background: transparent;
  }
  .avonent-guarantee-section,
  .avonent-guarantee-section * { box-sizing: border-box; }
  .avonent-guarantee__inner { width: min(100%, 1070px); margin: 0 auto; }
  .avonent-guarantee__panel {
    position: relative;
    isolation: isolate;
    overflow: visible;
    text-align: center;
    padding: clamp(98px,9vw,122px) clamp(24px,6vw,82px) clamp(39px,5vw,63px);
    border: 1px solid rgba(96, 221, 251, .38);
    border-radius: 24px;
    color: #FFFFFF;
    background:
      radial-gradient(ellipse at 110% 6%, rgba(0,200,240,.33) 0%, transparent 39%),
      radial-gradient(ellipse at 0% 93%, rgba(0,122,180,.25), transparent 43%),
      linear-gradient(125deg,#04152D 0%,#07365A 57%,#06182E 100%);
    box-shadow: 0 25px 70px rgba(2,38,69,.17), inset 0 1px 0 rgba(255,255,255,.14);
  }
  .avonent-guarantee__panel::before {
    content: "";
    pointer-events: none;
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(143deg, transparent 29%, rgba(121,230,255,.085) 44%, transparent 57%);
  }
  .avonent-guarantee__panel::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(180deg,rgba(1,17,40,.06),rgba(1,17,40,.55));
  }
  .avonent-guarantee__background {
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    opacity: .44;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .avonent-guarantee__badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%,-52%);
    width: clamp(167px, 19vw, 236px);
    height: auto;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 14px 18px rgba(0,14,30,.24));
  }
  .avonent-guarantee__badge-image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .avonent-guarantee__content { position: relative; z-index: 1; }
  .avonent-guarantee__content h2 {
    max-width: 830px;
    margin: 0 auto 22px;
    color: #FFFFFF !important;
    font-size: clamp(38px,4.7vw,66px);
    line-height: 1.09;
    font-weight: 780;
    letter-spacing: -.04em;
    text-wrap: balance;
  }
  .avonent-guarantee__description {
    max-width: 740px;
    margin: 0 auto;
    color: #DDEEF8;
    font-size: clamp(16px,1.7vw,21px);
    line-height: 1.65;
  }
  .avonent-guarantee__description p { margin: 0; color: inherit; line-height: inherit; }
  .avonent-guarantee__features {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    max-width: 850px;
    margin: 30px auto 34px;
  }
  .avonent-guarantee__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 1 auto;
    gap: 10px;
    min-height: 44px;
    padding: 11px 17px;
    border-radius: 9px;
    background: rgba(233,249,255,.11);
    border: 1px solid rgba(185,238,255,.24);
    color: #FFFFFF;
    font-size: clamp(13px,1.25vw,16px);
    font-weight: 600;
    line-height: 1.4;
    white-space: normal;
  }
  .avonent-guarantee__chip > span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 21px;
    width: 21px;
    height: 21px;
    border-radius: 50%;
    color: #09283A;
    background: var(--av-guarantee-accent, #02C6EA);
    font-size: 13px;
    font-weight: 850;
  }
  .avonent-guarantee__button,
  .avonent-guarantee__button:visited {
    display: flex !important;
    align-items: center;
    justify-content: center;
    gap: 15px;
    width: min(100%,720px);
    min-height: 67px;
    margin: 0 auto;
    padding: 15px 25px;
    border: none !important;
    border-radius: 11px;
    font-size: clamp(17px,2.1vw,23px);
