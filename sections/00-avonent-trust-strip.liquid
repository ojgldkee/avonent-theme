    transition: transform .2s ease, filter .2s ease;
  }
  .avonent-guarantee__button:hover {
    filter: brightness(1.08);
    color: #04263A !important;
    transform: translateY(-2px);
  }
  .avonent-guarantee__button:focus-visible { outline: 3px solid #FFFFFF; outline-offset: 4px; }
  /* Prevent homepage theme button styles from hiding the guarantee CTA. */
  .avonent-guarantee-section a.avonent-guarantee__button {
    opacity: 1 !important;
    visibility: visible !important;
    text-shadow: none !important;
    -webkit-text-fill-color: #04263A;
  }
  .avonent-faq-proofs .avonent-guarantee__inner { max-width: 1050px; }
