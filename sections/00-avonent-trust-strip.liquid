  .avonent-health-gallery__stars{display:inline-flex;align-items:center;gap:2px;color:#E8A200}
  .avonent-health-gallery__stars svg{display:block;width:16px;height:16px;flex:none}
  .avonent-health-gallery__product-title{font-family:var(--font-heading--family);font-size:clamp(22px,2.2vw,29px);font-weight:760;letter-spacing:-.028em;line-height:1.16;color:#092D46;margin:0}
  .avonent-health-gallery__product-description{color:#4A6170;font-size:16px;line-height:1.5;margin:11px 0 18px;min-height:48px}
  .avonent-health-gallery__product-price{color:#092D46;font-size:24px;font-weight:820;margin-top:auto}
  .avonent-health-gallery__product-cta,.avonent-health-gallery__product-cta:visited{display:flex;align-items:center;justify-content:center;gap:10px;min-height:45px;margin-top:18px;padding:9px 16px;border:1.5px solid #078EB3;border-radius:8px;background:#02C6EA;color:#052D42!important;-webkit-text-fill-color:#052D42;font-size:16px;font-weight:760;line-height:1.25;text-decoration:none!important;transition:background-color .15s cubic-bezier(.16,1,.3,1),transform .15s cubic-bezier(.16,1,.3,1)}
  .avonent-health-gallery__product-cta:hover{background:#7AE5F5}
  .avonent-health-gallery__product-cta:active{transform:scale(.97)}
  .avonent-health-gallery__product-cta:focus-visible{outline:3px solid #075A7A;outline-offset:3px}
  .avonent-health-gallery__product .avonent-health-gallery__media-link:focus-visible{outline:3px solid #075A7A;outline-offset:-3px}
  @media(max-width:749px){
    .avonent-health-gallery__slide.avonent-health-gallery__product{flex:0 0 min(83vw,420px);border-radius:15px}
    .avonent-health-gallery__product .avonent-health-gallery__image{aspect-ratio:1.1/1}
    .avonent-health-gallery__product-body{padding:18px 18px 20px}
    .avonent-health-gallery__rating{font-size:13px;gap:9px;margin-bottom:12px}
    .avonent-health-gallery__stars svg{width:15px;height:15px}
    .avonent-health-gallery__product-title{font-size:23px}
    .avonent-health-gallery__product-description{font-size:14px;line-height:1.44;margin:9px 0 14px}
    .avonent-health-gallery__product-price{font-size:22px}
    .avonent-health-gallery__product-cta{min-height:44px;font-size:15px;margin-top:15px}
  }
  @media(prefers-reduced-motion:reduce){.avonent-health-gallery__product-cta{transition:none}}
