        <details class="avonent-faq-proofs__question">
          <summary><span>{{ section.settings.faq_q2 | escape }}</span><span class="avonent-faq-proofs__toggle" aria-hidden="true"></span></summary>
          <div class="avonent-faq-proofs__answer rte">{{ section.settings.faq_a2 }}</div>
        </details>
        <details class="avonent-faq-proofs__question">
          <summary><span>{{ section.settings.faq_q3 | escape }}</span><span class="avonent-faq-proofs__toggle" aria-hidden="true"></span></summary>
          <div class="avonent-faq-proofs__answer rte">{{ section.settings.faq_a3 }}</div>
