  }
  @media(prefers-reduced-motion:reduce){.avonent-health-gallery__rail{scroll-behavior:auto}.avonent-health-gallery__arrow{transition:none}}

  /* Product carousel: storefront cards with editable Shopify blocks. */
  .avonent-health-gallery__slide.avonent-health-gallery__product{display:flex;flex-direction:column;background:#fff;border:1px solid #DCEBF2;border-radius:18px;box-shadow:0 12px 38px rgba(4,44,73,.10);overflow:hidden}
  .avonent-health-gallery__product .avonent-health-gallery__media-link{display:block;overflow:hidden;background:#E7F5F8;line-height:0}
  .avonent-health-gallery__product .avonent-health-gallery__image{width:100%;height:auto;aspect-ratio:1.18/1;object-fit:cover}
  .avonent-health-gallery__pack-art{display:block;width:100%;height:auto;aspect-ratio:1.18/1;object-fit:cover}
  .avonent-health-gallery__product-body{display:flex;flex-direction:column;align-items:stretch;flex:1;padding:22px 24px 24px}
  .avonent-health-gallery__rating{display:flex;align-items:center;flex-wrap:wrap;gap:12px;color:#183C51;font-size:15px;line-height:1.25;margin:0 0 14px}
