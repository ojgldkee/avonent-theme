{% comment %}
  Simple subscription-management landing page. Appstle handles authenticated
  actions (skip, reschedule, pause, cancellation) in its customer portal.
  Do not simulate subscription actions from this theme page.
{% endcomment %}
{% liquid
  assign av_portal_link = section.settings.portal_url
  if av_portal_link == blank
    assign av_portal_link = '/apps/subscriptions'
  endif
%}
<style>
  #shopify-section-{{ section.id }} .av-portal {
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .av-portal__wrap {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .av-portal__hero {
    background: {{ section.settings.hero_background }};
    color: {{ section.settings.hero_text_color }};
    border-radius: 22px;
    padding: clamp(28px, 5vw, 48px);
  }
  #shopify-section-{{ section.id }} .av-portal__eyebrow {
    color: #d8e7d1;
    font-size: 12px;
    font-weight: 750;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  #shopify-section-{{ section.id }} .av-portal__hero h1 {
    color: inherit;
    font-size: clamp(32px, 5vw, 50px);
    line-height: 1.08;
    letter-spacing: -.035em;
    font-weight: 750;
    margin: 0 0 16px;
  }
  #shopify-section-{{ section.id }} .av-portal__lead {
    max-width: 600px;
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.55;
    opacity: .92;
  }
  #shopify-section-{{ section.id }} .av-portal__lead p {margin: 0}
  #shopify-section-{{ section.id }} .av-portal__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 50px;
    padding: 12px 24px;
    margin-top: 25px;
    border-radius: 10px;
    background: #fff;
    color: {{ section.settings.hero_background }};
    text-decoration: none;
    font-size: 15px;
    font-weight: 750;
    transition: opacity .2s ease;
  }
  #shopify-section-{{ section.id }} .av-portal__cta:hover {opacity: .9}
  #shopify-section-{{ section.id }} .av-portal__instructions {
    font-size: 13px;
    line-height: 1.45;
    opacity: .82;
    margin: 15px 0 0;
  }
  #shopify-section-{{ section.id }} .av-portal__appstle-button {margin-top: 16px}
  #shopify-section-{{ section.id }} .av-portal__options {margin-top: 34px}
  #shopify-section-{{ section.id }} .av-portal__options h2 {
    color: inherit;
    margin: 0 0 17px;
    font-size: clamp(22px, 3vw, 27px);
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -.02em;
  }
  #shopify-section-{{ section.id }} .av-portal__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .av-portal__card {
    background: {{ section.settings.card_background }};
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 14px;
    padding: 22px;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .av-portal__card h3 {
    color: inherit;
    font-size: 17px;
    line-height: 1.3;
    font-weight: 750;
    margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .av-portal__card p {
    color: inherit;
    opacity: .78;
    font-size: 14px;
    line-height: 1.55;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .av-portal__closing {
    padding: 22px 0 0;
    margin-top: 24px;
    border-top: 1px solid {{ section.settings.border_color }};
  }
  #shopify-section-{{ section.id }} .av-portal__closing h2 {
    color: inherit;
    font-size: 18px;
    font-weight: 750;
    margin: 0 0 6px;
  }
  #shopify-section-{{ section.id }} .av-portal__closing p {
    color: inherit;
    opacity: .82;
    font-size: 14px;
    line-height: 1.55;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .av-portal__faq {
    border-bottom: 1px solid {{ section.settings.border_color }};
    padding: 16px 0;
  }
  #shopify-section-{{ section.id }} .av-portal__faq summary {
    cursor: pointer;
    font-weight: 700;
  }
  #shopify-section-{{ section.id }} .av-portal__faq .rte {margin-top: 10px}
  #shopify-section-{{ section.id }} .av-portal__app {margin: 18px 0}
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .av-portal {
      padding: {{ section.settings.mobile_padding }}px 16px;
    }
    #shopify-section-{{ section.id }} .av-portal__hero {
      padding: 30px 22px;
      border-radius: 18px;
    }
    #shopify-section-{{ section.id }} .av-portal__grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    #shopify-section-{{ section.id }} .av-portal__card {padding: 18px}
    #shopify-section-{{ section.id }} .av-portal__cta {width: 100%}
    #shopify-section-{{ section.id }} .av-portal__options {margin-top: 27px}
  }
</style>

<div class="av-portal">
  <div class="av-portal__wrap">
    <header class="av-portal__hero">
      {% if section.settings.eyebrow != blank %}
        <p class="av-portal__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
      {% if section.settings.intro != blank %}
        <div class="av-portal__lead rte">{{ section.settings.intro }}</div>
      {% endif %}
      <a class="av-portal__cta" href="{{ av_portal_link }}">{{ section.settings.button_text | escape }}</a>
      {% if section.settings.instructions != blank %}
        <p class="av-portal__instructions">{{ section.settings.instructions | escape }}</p>
      {% endif %}
      {% if section.settings.appstle_placeholder %}
        <div class="av-portal__appstle-button" id="appstle-subscription-manage-subscription-button-placeholder"></div>
      {% endif %}
    </header>

    {% assign av_options_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'info' %}
        {% assign av_options_count = av_options_count | plus: 1 %}
      {% endif %}
    {% endfor %}
    {% if av_options_count > 0 %}
      <section class="av-portal__options" aria-label="{{ section.settings.options_heading | escape }}">
        {% if section.settings.options_heading != blank %}
          <h2>{{ section.settings.options_heading | escape }}</h2>
        {% endif %}
        <div class="av-portal__grid">
          {% for block in section.blocks %}
            {% if block.type == 'info' %}
              <article class="av-portal__card" {{ block.shopify_attributes }}>
                <h3>{{ block.settings.heading | escape }}</h3>
                {% if block.settings.body != blank %}
                  <p>{{ block.settings.body | escape | newline_to_br }}</p>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if section.settings.cancel_heading != blank or section.settings.cancel_note != blank %}
      <div class="av-portal__closing">
        {% if section.settings.cancel_heading != blank %}
          <h2>{{ section.settings.cancel_heading | escape }}</h2>
        {% endif %}
        {% if section.settings.cancel_note != blank %}
          <p>{{ section.settings.cancel_note | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'faq' %}
          <details class="av-portal__faq" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}</summary>
            <div class="rte">{{ block.settings.answer }}</div>
          </details>
        {% when '@app' %}
          <div class="av-portal__app">{% render block %}</div>
      {% endcase %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Manage subscription",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Small label","default":"Your subscription"},
    {"type":"text","id":"heading","label":"Heading","default":"Need a break?"},
    {"type":"richtext","id":"intro","label":"Introduction","default":"<p>You can change your next delivery without ending your subscription. Choose what works best for you.</p>"},
    {"type":"url","id":"portal_url","label":"Subscription portal link"},
    {"type":"text","id":"button_text","label":"Button text","default":"Manage my subscription"},
    {"type":"textarea","id":"instructions","label":"Text below button","default":"Change your schedule, pause, or cancel in the customer portal."},
    {"type":"checkbox","id":"appstle_placeholder","label":"Show additional Appstle Classic button","default":false},
    {"type":"text","id":"options_heading","label":"Options heading","default":"A few ways to take a break"},
    {"type":"text","id":"cancel_heading","label":"Cancellation heading","default":"Still want to cancel?"},
    {"type":"textarea","id":"cancel_note","label":"Cancellation note","default":"You can cancel through the same customer portal. We won't make you contact support to do it."},
    {"type":"color","id":"background","label":"Page background","default":"#F7FAF5"},
    {"type":"color","id":"hero_background","label":"Hero background","default":"#355A38"},
    {"type":"color","id":"hero_text_color","label":"Hero text","default":"#FFFFFF"},
    {"type":"color","id":"card_background","label":"Cards background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Main text","default":"#222B23"},
    {"type":"color","id":"accent","label":"Accent color","default":"#557D4B"},
    {"type":"color","id":"border_color","label":"Border color","default":"#DAE7D6"},
    {"type":"range","id":"content_width","label":"Content width","min":600,"max":1200,"step":20,"default":900,"unit":"px"},
    {"type":"range","id":"padding_top","label":"Top spacing","min":0,"max":120,"step":4,"default":48,"unit":"px"},
    {"type":"range","id":"padding_bottom","label":"Bottom spacing","min":0,"max":120,"step":4,"default":64,"unit":"px"},
    {"type":"range","id":"mobile_padding","label":"Mobile spacing","min":0,"max":80,"step":4,"default":24,"unit":"px"}
  ],
  "blocks": [
    {"type":"info","name":"Option","settings":[
      {"type":"text","id":"heading","label":"Heading","default":"Skip a delivery"},
      {"type":"textarea","id":"body","label":"Description","default":"Have enough left? Skip your next shipment."}
    ]},
    {"type":"faq","name":"FAQ (optional)","settings":[
      {"type":"text","id":"question","label":"Question","default":"How do I cancel?"},
      {"type":"richtext","id":"answer","label":"Answer","default":"<p>Open your customer portal and choose the cancellation option.</p>"}
    ]},
    {"type":"@app"}
  ],
  "presets":[{"name":"Manage subscription","blocks":[
    {"type":"info"},{"type":"info"},{"type":"info"}
  ]}]
}
{% endschema %}
