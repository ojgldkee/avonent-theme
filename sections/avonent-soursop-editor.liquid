{% capture survivor_rows %}
  {% for index in (1..4) %}
    {% assign percent_key = 'sr_pct_' | append: index %}
    {% assign label_key = 'sr_label_' | append: index %}
    {% assign percent = section.settings[percent_key] %}
    {% if section.settings[label_key] != blank and percent != blank and percent >= 0 and percent <= 100 %}
      {% assign display_percent = percent | round %}
      <li>
        <div class="av-survivor-results__ring">
          <svg viewBox="0 0 80 80" aria-hidden="true" focusable="false">
            <circle cx="40" cy="40" r="36" pathLength="100" transform="rotate(-90 40 40)" stroke-dasharray="{{ display_percent }} {{ 100 | minus: display_percent }}" />
          </svg>
          <strong>{{ display_percent }}%</strong>
        </div>
        <span>{{ section.settings[label_key] | escape }}</span>
      </li>
    {% endif %}
  {% endfor %}
{% endcapture %}
{% assign survivor_rows = survivor_rows | strip %}
{% capture survivor_results %}
  {% if section.settings.sr_image != blank or survivor_rows != blank or section.settings.sr_intro != blank %}
    <section class="av-survivor-results">
      {% if section.settings.sr_image != blank %}
        {{ section.settings.sr_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '400,750,1100,1800' }}
      {% else %}
        <h2>{{ section.settings.sr_heading | escape }}</h2>
        {% if survivor_rows != blank %}<ul>{{ survivor_rows }}</ul>{% else %}<p>{{ section.settings.sr_intro | escape }}</p>{% endif %}
      {% endif %}
    </section>
  {% endif %}
{% endcapture %}
{% render '00-cinnamon-berberine-page', product: product, editor: section, survivor_results: survivor_results %}
<style>
.av-survivor-results {box-sizing:border-box;max-width:960px;margin:20px auto;padding:0 12px}
.av-survivor-results img {display:block;width:100%;height:auto}
#shopify-section-{{ section.id }} .av-survivor-results h2 {
  color:{{ section.settings.sr_heading_color }};
  font-size:{{ section.settings.sr_heading_size | default: 30 }}px;
  line-height:1.15;
  margin:0 0 22px;
  text-align:center;
  text-wrap:balance;
}
.av-survivor-results ul {
  list-style:none;
  padding:0;
  margin:0;
  border-top:1px solid #e8e8e8;
}
.av-survivor-results li {
  display:grid;
  grid-template-columns:var(--result-ring-size) minmax(0,1fr);
  gap:clamp(12px,4vw,24px);
  align-items:center;
  padding:12px 0;
  border-bottom:1px solid #e8e8e8;
  color:{{ section.settings.sr_text_color }};
  font-size:18px;
  line-height:1.3;
  --result-ring-size:clamp(62px,18vw,82px);
}
#shopify-section-{{ section.id }} .av-survivor-results__ring {
  position:relative;
  display:grid;
  place-items:center;
  width:var(--result-ring-size);
  aspect-ratio:1;
  color:{{ section.settings.sr_circle_color }};
}
.av-survivor-results__ring svg {position:absolute;inset:0;display:block;width:100%;height:100%}
.av-survivor-results__ring circle {fill:none;stroke:currentColor;stroke-width:8;stroke-linecap:butt}
#shopify-section-{{ section.id }} .av-survivor-results__ring strong {
  color:inherit;
  font-size:clamp(19px,5vw,24px);
  font-weight:800;
  line-height:1;
}
</style>
{% if product.template_suffix == 'soursop' and request.design_mode == false %}
<style>
/* Soursop page only: discourage ordinary selection and copying without disabling form fields. */
html.av-soursop-copy-guard body,
html.av-soursop-copy-guard body *:not(input):not(textarea):not(select):not(option):not([contenteditable]):not([contenteditable] *) {
  -webkit-user-select: none !important;
  user-select: none !important;
  -webkit-touch-callout: none !important;
}
html.av-soursop-copy-guard input,
html.av-soursop-copy-guard textarea,
html.av-soursop-copy-guard select,
html.av-soursop-copy-guard [contenteditable],
html.av-soursop-copy-guard [contenteditable] * {
  -webkit-user-select: text !important;
  user-select: text !important;
  -webkit-touch-callout: default !important;
}
</style>
<script>
(() => {
  if (document.documentElement.classList.contains('av-soursop-copy-guard')) return;
  document.documentElement.classList.add('av-soursop-copy-guard');
  const editable = (target) => target instanceof Element && !!target.closest('input, textarea, select, [contenteditable], [role="textbox"]');
  document.addEventListener('copy', (event) => {
    if (!editable(event.target)) event.preventDefault();
  }, true);
  document.addEventListener('contextmenu', (event) => {
    if (!editable(event.target)) event.preventDefault();
  }, true);
})();
</script>
{% endif %}
