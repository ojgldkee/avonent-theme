{% liquid
  assign desktop_image = section.settings.image | default: section.settings.mobile_image
  assign mobile_image = section.settings.mobile_image
  assign image_alt = section.settings.alt_text | default: desktop_image.alt
%}
<style>
  #shopify-section-{{ section.id }} .av-image {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .av-image__inner {
    width: min(calc(100% - 32px), {% case section.settings.width %}{% when 'wide' %}1600px{% when 'narrow' %}900px{% else %}1200px{% endcase %});
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .av-image__media {
    display: block;
    overflow: hidden;
    border-radius: {{ section.settings.radius }}px;
  }
  #shopify-section-{{ section.id }} .av-image__media img,
  #shopify-section-{{ section.id }} .av-image__media svg {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .av-image {padding: {{ section.settings.mobile_padding }}px 0}
    #shopify-section-{{ section.id }} .av-image__inner {width: {% if section.settings.full_mobile %}100%{% else %}calc(100% - 24px){% endif %}}
    #shopify-section-{{ section.id }} .av-image__media {border-radius: {% if section.settings.full_mobile %}0{% else %}{{ section.settings.radius }}px{% endif %}}
  }
</style>
{% if desktop_image != blank or request.design_mode %}
  <div class="av-image">
    <div class="av-image__inner">
      {% if section.settings.link != blank %}<a class="av-image__media" href="{{ section.settings.link }}">{% else %}<div class="av-image__media">{% endif %}
        {% if desktop_image != blank %}
          <picture>
            {% if mobile_image != blank %}
              <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 900 }} 900w, {{ mobile_image | image_url: width: 1200 }} 1200w" sizes="100vw">
            {% endif %}
            {{ desktop_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200, 1600, 2000, 2400', sizes: '100vw', alt: image_alt }}
          </picture>
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      {% if section.settings.link != blank %}</a>{% else %}</div>{% endif %}
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name": "Image",
  "settings": [
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)"},
    {"type": "text", "id": "alt_text", "label": "Alt text"},
    {"type": "url", "id": "link", "label": "Link (optional)"},
    {"type": "select", "id": "width", "label": "Width", "options": [
      {"value": "wide", "label": "Wide"},
      {"value": "page", "label": "Page"},
      {"value": "narrow", "label": "Narrow"}
    ], "default": "page"},
    {"type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0},
    {"type": "checkbox", "id": "full_mobile", "label": "Full width on mobile", "default": false},
    {"type": "color", "id": "background", "label": "Background", "default": "#FFFFFF"},
    {"type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24},
    {"type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24},
    {"type": "range", "id": "mobile_padding", "label": "Mobile spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 12}
  ],
  "presets": [{"name": "Image", "category": "Media"}]
}
{% endschema %}